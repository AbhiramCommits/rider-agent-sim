# LLM provider keys.
# `make simulate` uses LLM decision mode when one of these is set
# (mode=auto), and falls back to the statistical decision model otherwise.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Optional: override the default models used by the LLM decision layer.
# ANTHROPIC_MODEL=claude-haiku-4-5
# OPENAI_MODEL=gpt-4o-mini
